rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Catch-All Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Reusable global security helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.email is string && data.email.size() <= 256
        && (data.role == 'client' || data.role == 'operator' || data.role == 'admin')
        && (data.clientTier == 'standard' || data.clientTier == 'frequent' || data.clientTier == 'vip')
        && (!('phone' in data) || data.phone is string)
        && (!('preferredContact' in data) || (data.preferredContact == 'celular' || data.preferredContact == 'correo'));
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.category is string && data.category.size() <= 128
        && data.price is number
        && data.stock is int;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.clientName is string && data.clientName.size() <= 256
        && data.clientTier is string && data.clientTier.size() <= 64
        && data.subtotal is number
        && data.total is number
        && data.status is string && data.status.size() <= 64;
    }

    function isValidKnowledgeEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.question is string && data.question.size() <= 1024
        && data.answer is string && data.answer.size() <= 8192;
    }

    // --- Users Profiles Partition ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // --- Catalog and Stock Levels ---
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    // --- Agent Generated Orders Queue ---
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    // --- System Knowledge Base ---
    match /knowledge_base/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId) && isValidKnowledgeEntry(request.resource.data);
      allow delete: if isValidId(entryId);
    }
  }
}
